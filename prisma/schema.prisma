generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")

  @@map("gender")
}

enum Day {
  SUNDAY    @map("sunday")
  MONDAY    @map("monday")
  TUESDAY   @map("tuesday")
  WEDNESDAY @map("wednesday")
  THURSDAY  @map("thursday")
  FRIDAY    @map("friday")
  SATURDAY  @map("saturday")

  @@map("day")
}

model Person {
  id             Int              @id @default(autoincrement()) @map("id")
  nik            String?          @map("nik")
  name           String           @map("name")
  gender         Gender           @map("gender")
  birthPlace     String?          @map("birth_place")
  birthDate      DateTime?        @map("birth_date")
  address        String?          @map("address")
  phone          String?          @unique @map("phone")
  email          String?          @unique @map("email")
  religion       String?          @map("religion")
  student        Student?
  teachSchedules CourseSchedule[]
  electionVoters ElectionVoter[]

  @@map("people")
}

model CampusRoom {
  id             Int              @id @default(autoincrement()) @map("id")
  name           String           @map("name")
  courseSchedule CourseSchedule[]

  @@map("campus_rooms")
}

model Course {
  id              Int              @id @default(autoincrement()) @map("id")
  name            String           @map("name")
  duration        Int              @map("duration")
  courseSchedules CourseSchedule[]

  @@map("courses")
}

model Dorm {
  id         Int             @id @default(autoincrement()) @map("id")
  name       String          @map("name")
  dormBlocks DormBlock[]
  residents  ActiveStudent[]

  @@map("dorms")
}

model DormBlock {
  id     Int    @id @default(autoincrement()) @map("id")
  dorm   Dorm   @relation(fields: [dormId], references: [id])
  dormId Int    @map("dorm_id")
  name   String @map("name")

  @@map("dorm_blocks")
}

model Batch {
  id       Int       @id @default(autoincrement()) @map("id")
  number   Int       @map("number")
  name     String?   @map("name")
  slogan   String?   @map("slogan")
  color    String?   @map("color")
  students Student[]

  @@map("batches")
}

model Student {
  id            Int                 @id @default(autoincrement()) @map("id")
  person        Person              @relation(fields: [personId], references: [id])
  personId      Int                 @unique @map("person_id")
  nim           String?             @map("nim")
  batch         Batch               @relation(fields: [batchId], references: [id])
  batchId       Int                 @map("batch_id")
  activeStudent ActiveStudent?
  candidacies   ElectionCandidate[]

  @@map("students")
}

model ActiveStudent {
  id                    Int                    @id @default(autoincrement()) @map("id")
  student               Student                @relation(fields: [studentId], references: [id])
  studentId             Int                    @unique @map("student_id")
  dorm                  Dorm                   @relation(fields: [dormId], references: [id])
  dormId                Int                    @map("dorm_id")
  dormCleaningSchedules DormCleaningSchedule[]
  courseGroups          CourseGroup[]
  spiritualPoints       Int                    @map("spiritual_points")
  spiritualPenalties    Int                    @map("spiritual_penalties")

  @@map("active_students")
}

model CourseGroup {
  id              Int              @id @default(autoincrement()) @map("id")
  name            String           @map("name")
  participants    ActiveStudent[]
  courseSchedules CourseSchedule[]

  @@map("course_groups")
}

model CourseSchedule {
  id            Int         @id @default(autoincrement()) @map("id")
  course        Course      @relation(fields: [courseId], references: [id])
  courseId      Int         @map("course_id")
  courseGroup   CourseGroup @relation(fields: [courseGroupId], references: [id])
  courseGroupId Int         @map("course_group_id")
  instructor    Person      @relation(fields: [instructorId], references: [id])
  instructorId  Int         @map("instructor_id")
  day           Day         @map("day")
  room          CampusRoom  @relation(fields: [campusRoomId], references: [id])
  campusRoomId  Int         @map("campus_room_id")

  @@map("course_schedules")
}

model DormCleaningSchedule {
  id        Int           @id @default(autoincrement()) @map("id")
  week      Int           @map("week")
  day       Day           @map("day")
  student   ActiveStudent @relation(fields: [studentId], references: [id])
  studentId Int           @map("student_id")

  @@map("dorm_cleaning_schedules")
}

model StudentRegistration {
  id   Int    @id @default(autoincrement()) @map("id")
  name String @map("name")

  @@map("student_registrations")
}

model Post {
  id        Int      @id @default(autoincrement()) @map("id")
  title     String   @map("title")
  content   String?  @map("content")
  published Boolean? @default(false) @map("published")
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?     @map("author_id")

  @@map("posts")
}

model Election {
  id          Int                 @id @default(autoincrement()) @map("id")
  title       String              @unique @map("title")
  date        DateTime            @default(now()) @map("date")
  cabinetName String              @map("cabinet_name")
  candidates  ElectionCandidate[]
  voters      ElectionVoter[]
  ballots     ElectionBallot[]

  @@map("elections")
}

model ElectionVoter {
  election   Election @relation(fields: [electionId], references: [id])
  electionId Int      @map("election_id")
  person     Person   @relation(fields: [personId], references: [id])
  personId   Int      @map("person_id")

  @@id([electionId, personId])
  @@map("election_voters")
}

model ElectionCandidate {
  election   Election         @relation(fields: [electionId], references: [id])
  electionId Int              @map("election_id")
  student    Student          @relation(fields: [studentId], references: [id])
  studentId  Int              @map("student_id")
  number     Int              @map("number")
  color      String           @map("color")
  nickname   String?          @map("nickname")
  photo      String?          @map("photo")
  vision     String?          @map("vision")
  missions   String[]         @map("missions")
  ballots    ElectionBallot[]
  votes      Int              @default(0) @map("votes")

  @@id([electionId, number])
  @@map("election_candidates")
}

model ElectionBallot {
  id         Int                @id @default(autoincrement()) @map("id")
  election   Election           @relation(fields: [electionId], references: [id])
  electionId Int                @map("election_id")
  number     Int?               @map("number")
  strength   Int                @default(1) @map("strength")
  token      String             @unique @map("token")
  candidate  ElectionCandidate? @relation(fields: [electionId, number], references: [electionId, number])
  counted    Boolean            @default(false) @map("counted")

  @@map("election_ballots")
}

model Account {
  id                Int     @id @default(autoincrement()) @map("id")
  type              String  @map("type")
  provider          String  @map("provider")
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token") @db.Text
  access_token      String? @map("access_token") @db.Text
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String? @map("scope")
  id_token          String? @map("id_token") @db.Text
  session_state     String? @map("session_state")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement()) @map("id")
  sessionToken String   @unique @map("session_token")
  expires      DateTime @map("expires")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int      @map("user_id")

  @@map("sessions")
}

model User {
  id            Int       @id @default(autoincrement()) @map("id")
  name          String?   @map("name")
  email         String?   @unique @map("email")
  emailVerified DateTime? @map("email_verified")
  image         String?   @map("image")
  accounts      Account[]
  sessions      Session[]
  posts         Post[]

  @@map("users")
}

model VerificationToken {
  identifier String   @map("identifier")
  token      String   @unique @map("token")
  expires    DateTime @map("expires")

  @@unique([identifier, token])
  @@map("verification_tokens")
}
